---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTABand from '@/components/CTABand.astro';
import PageHero from '@/components/PageHero.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Heidi Blondin",
  "honorificSuffix": "BA, CFP®, EPC",
  "jobTitle": "Certified Financial Planner",
  "url": "https://heidiblondin.com/heidi/",
  "image": "https://heidiblondin.com/team/heidi-corp468.jpeg",
  "telephone": "+16138872726",
  "email": "hbadmin@heidiblondin.com",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Queen's University"
  },
  "worksFor": {
    "@type": "FinancialService",
    "name": "Heidi Blondin Financial Inc.",
    "url": "https://heidiblondin.com"
  },
  "sameAs": ["https://www.linkedin.com/in/heidiblondin/"]
};
---

<BaseLayout
  title="About Heidi Blondin, Female Certified Financial Planner"
  description="Are you looking for honest, and holistic financial planning advice? Heidi Blondin Financial is locally owned an operated by women who genuinely care."
  image="/team/heidi-corp468.jpeg"
>

  <PageHero
    eyebrow="Certified Financial Planner"
    title="Heidi Blondin, BA, CFP&#174;, EPC"
    titleClass="font-serif text-display text-white max-w-2xl mx-auto text-balance"
    padding="py-20 lg:py-24"
    center
  />

  <section class="bg-white section-gap">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

        <!-- Portrait -->
        <div class="lg:col-span-5">
          <img
            src="/team/heidi-corp468.jpeg"
            alt="Heidi Blondin, CFP® — Certified Financial Planner, Kingston Ontario"
            class="w-full aspect-[3/4] object-cover object-top"
            loading="eager"
            width="1200"
            height="1800"
          />
        </div>

        <!-- Her story -->
        <div class="lg:col-span-7">
          <h2 class="font-serif text-h2 text-brand-plum mb-6">Beyond the Office</h2>

          <div class="space-y-6 font-sans text-[18px] text-brand-ink/75 leading-relaxed">
            <p>When I'm not working with clients, you'll likely find me enjoying the simple things that bring me joy and keep me grounded. Whether I'm out on the river, painting, quilting, scrapbooking, or creating something new, I love finding opportunities to express my creative side.</p>
            <p>Family is at the heart of everything I do. I'm a proud mother to Jack and Karli, and nothing brings me more happiness than being a grandma and spending time with the little people in our lives. I also cherish time with my husband, John, whether we're enjoying quiet moments at home, exploring new places, or sharing life's adventures together.</p>
            <p>Travel is another passion of mine, particularly visiting Europe. I love experiencing different cultures, history, architecture, and local traditions. Each journey provides new perspectives, treasured memories, and inspiration that I carry into both my personal and professional life.</p>
            <p>Some of my favourite moments are gathered around the table with family and friends—cooking, entertaining, sharing stories, and creating memories together. I also cherish peaceful evenings at home, watching the sunset from my rocking chair and reflecting on all there is to be grateful for.</p>
            <p>At my core, I am someone who genuinely loves helping people. Building meaningful relationships, supporting others through important life decisions, and celebrating their successes is what inspires me every day. I believe that kindness, compassion, and caring for people aren't just values—they're the foundation of both my personal life and my work with clients.</p>
          </div>

          <blockquote class="mt-10 border-l-2 border-brand-gold pl-6 lg:pl-8">
            <p class="font-serif text-[22px] lg:text-[26px] text-brand-plum leading-snug text-balance">
              My hope is that every client who works with me feels welcomed, cared for, and supported—because helping people isn't just what I do, it's who I am.
            </p>
          </blockquote>

          <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-x-8 gap-y-4">
            <a href="/about/" class="font-sans text-[18px] font-medium text-brand-goldDark underline underline-offset-2 hover:text-amber-700">Read Heidi's professional bio →</a>
            <a href="/about/" class="font-sans text-[18px] font-medium text-brand-goldDark underline underline-offset-2 hover:text-amber-700">Meet the team →</a>
          </div>
        </div>

      </div>

      <!-- Heidi's personal photos go here, as a 3-up strip — same pattern as /angela/ and /joanne/. -->

    </div>
  </section>

  <CTABand
    heading="Let's talk about what matters most to you"
    sub="Schedule a free, no-obligation consultation with Heidi and let's talk about where you are and where you want to be."
  />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

</BaseLayout>
