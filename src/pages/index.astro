---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTABand from '@/components/CTABand.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getAllPosts } from '@/lib/posts';

const recentPosts = (await getAllPosts()).slice(0, 3);
---

<BaseLayout
  title="Heidi Blondin Financial - Financial Services | Mutual Funds | Insurance"
  description="At Heidi Blondin Financial, we are passionate about working with families to develop strategies to eliminate debt, protect their loved ones and live the retirement of their dreams."
>

  <!-- Hero -->
  <section class="bg-brand-tintPlum">
    <picture>
      <source media="(max-width: 767px)" srcset="/team/homepage-banner-2026-mobile.jpg" width="1061" height="613" />
      <img
        src="/team/homepage-banner-2026-desktop.jpg"
        alt="The Heidi Blondin Financial team, Kingston, Ontario"
        class="w-full block"
        loading="eager"
        decoding="async"
        width="2603"
        height="613"
      />
    </picture>
  </section>

  <!-- Headline + body copy -->
  <section class="bg-brand-tintPlum section-gap-sm">
    <div class="container-content max-w-4xl">
      <h1 class="font-serif text-brand-plum mb-8 text-balance" style="font-size: clamp(1.4rem, 3.15vw, 2.625rem); line-height: 1.05; letter-spacing: -0.02em;">
        Are your life goals &amp; your money<br/><em class="text-brand-gold" style="font-style: italic; font-variation-settings: 'SOFT' 80;">working in harmony?</em>
      </h1>
      <div class="font-sans text-[17px] text-brand-ink/75 leading-relaxed space-y-4">
        <p>Finding the right balance between living for today and planning a financial healthy future that makes you feel excited, can seem like a daunting challenge. After all, the way you spend and invest your money can have a dramatic impact on the joy you feel in your life. But once you align your investments with the things in life that bring you happiness and inspiration, you can almost feel the worry and stress fall away.</p>
        <p>True wealth - the kind that follows you through life - is about having and doing what YOU want.</p>
        <p>Maybe that means making a difference in your community? Or ensuring your family always has what they need? Aligning your money with your life goals puts you in control. Sure, life will offer up some twists and turns. But ultimately, your financial peace of mind boils down to three key questions:</p>
      </div>
    </div>
  </section>

  <!-- Three questions band -->
  <section class="bg-brand-plum">
    <div class="grid grid-cols-1 lg:grid-cols-2">

      <!-- Questions, on solid plum -->
      <div class="flex items-center py-16 lg:py-24 px-6 lg:px-10">
        <div class="w-full lg:max-w-[600px] lg:ml-auto lg:pr-12">
          <p class="eyebrow-light mb-8">The questions we answer every day</p>
          <div class="space-y-8 lg:space-y-10">
            {[
              { num: '1', q: 'Will I have enough money?' },
              { num: '2', q: 'Will my family be ok if life throws them a curveball?' },
              { num: '3', q: "Do I feel good about the way I'm investing my money?" },
            ].map(item => (
              <div class="flex gap-5">
                <div class="font-serif text-4xl text-brand-gold font-normal leading-none flex-shrink-0 w-8">{item.num}</div>
                <p class="font-serif text-xl lg:text-2xl text-white leading-snug" style="font-style: italic; font-variation-settings: 'SOFT' 60;">
                  &ldquo;{item.q}&rdquo;
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Painting, full strength, no overlay -->
      <img
        src="/illustrations/home-band.jpg"
        alt="Three generations of a family talking around the table after a meal"
        width="1584"
        height="672"
        loading="lazy"
        decoding="async"
        class="w-full h-64 sm:h-80 lg:h-full lg:min-h-[540px] object-cover object-right"
      />

    </div>
  </section>

  <!-- Body copy + office photo -->
  <section class="bg-white section-gap">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="space-y-5">
          <p class="font-sans text-[17px] text-brand-ink/75 leading-relaxed">
            At Heidi Blondin Financial, we've been helping professionals just like you, answer these questions in a way that allows you to spend more time enjoying life - and less time fretting about your financial future.
          </p>
          <p class="font-sans text-[17px] text-brand-ink/75 leading-relaxed">
            We provide one-on-one financial planning and fun interactive workshops to help you learn, grow, and succeed.
          </p>
          <p class="font-sans text-[17px] text-brand-ink/75 leading-relaxed">
            If you're ready to start taking control of your money, contact us to schedule a free consultation.
          </p>
          <p class="font-sans text-[17px] text-brand-ink/75 leading-relaxed font-medium">
            You're one phone call away from living life the way YOU want.
          </p>
          <div class="pt-2">
            <a href="tel:18558443927" class="btn-primary">Call 1 (855) 844-3927</a>
          </div>
        </div>
        <div>
          <img
            src="/office/hbf-office.jpg"
            alt="Heidi Blondin Financial office, Kingston, Ontario"
            class="w-full"
            loading="lazy"
            width="1800"
            height="1339"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="bg-brand-tintPlum section-gap">
    <div class="container-content max-w-3xl">
      <div class="aspect-video w-full">
        <iframe
          src="https://www.youtube.com/embed/oFLLha7E304"
          title="About Heidi Blondin Financial"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Awards -->
  <section class="bg-white section-gap">
    <div class="container-content">
      <p class="eyebrow text-center mb-10">Heidi Blondin Financial Recent Awards</p>
      <div class="flex justify-center">
        <img
          src="/awards.png"
          alt="Heidi Blondin Financial awards — ThreeBest Rated, CommunityVotes Kingston"
          class="max-w-full"
          loading="lazy"
          width="1200"
          height="300"
        />
      </div>
    </div>
  </section>

  <!-- Recent blog posts -->
  {recentPosts.length > 0 && (
    <section class="bg-brand-tintSage section-gap">
      <div class="container-content">
        <div class="flex items-end justify-between mb-12">
          <div>
            <p class="eyebrow mb-3">Recent Posts</p>
            <h2 class="font-serif text-h2 text-brand-plum">Financial insights worth reading</h2>
          </div>
          <a href="/blog/" class="hidden md:flex items-center gap-2 font-sans text-sm font-medium text-brand-goldDark hover:gap-3 transition-all">
            All posts
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentPosts.map(post => (
            <BlogCard
              slug={post.slug}
              title={post.title}
              excerpt={post.excerpt}
              category={post.category}
              published_at={post.published_at}
              cover_image={post.cover_image}
            />
          ))}
        </div>
        <div class="text-center mt-10 md:hidden">
          <a href="/blog/" class="btn-ghost">All Posts</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CTABand />


</BaseLayout>
