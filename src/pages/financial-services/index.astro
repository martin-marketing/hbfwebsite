---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';

const mostRequested = [
  { label: 'Life Insurance', href: '/financial-services/life-insurance/' },
  { label: 'RRSP', href: '/financial-services/registered-retirement-savings-plans/' },
  { label: 'TFSA', href: '/financial-services/tax-free-savings-accounts/' },
  { label: 'Critical Illness', href: '/financial-services/critical-illness-insurance/' },
];

const sections = [
  {
    heading: 'Investing',
    image: '/illustrations/investing.jpg',
    imageAlt: 'A couple sitting together on the front steps of their home at golden hour',
    overview: { label: 'Investments Overview', href: '/financial-services/investments/' },
    links: [
      { label: 'RRSP', href: '/financial-services/registered-retirement-savings-plans/' },
      { label: 'TFSA', href: '/financial-services/tax-free-savings-accounts/' },
      { label: 'Segregated Funds', href: '/financial-services/segregated-fund/' },
      { label: 'FHSA', href: '/financial-services/first-home-savings-account/' },
      { label: 'RESP', href: '/financial-services/registered-education-savings-plans/' },
      { label: 'Group Retirement Savings', href: '/financial-services/group-savings-plans/' },
      { label: 'Manulife', href: '/all-in-banking/' },
    ],
    cta: null,
  },
  {
    heading: 'Insurance',
    image: '/illustrations/insurance.jpg',
    imageAlt: 'Parents and two young children reading a picture book together on the sofa',
    overview: { label: 'Insurance Overview', href: '/financial-services/insurance/' },
    links: [
      { label: 'Life Insurance', href: '/financial-services/life-insurance/' },
      { label: 'Critical Illness', href: '/financial-services/critical-illness-insurance/' },
      { label: 'Travel Insurance', href: '/financial-services/travel-insurance/' },
      { label: 'Group Benefits & Savings', href: '/financial-services/employee-group-benefits-plans/' },
      { label: 'Individual Health & Dental', href: '/financial-services/individual-health-dental-plans/' },
      { label: 'Disability Insurance', href: '/financial-services/disability-insurance/' },
      { label: 'Combination Insurance', href: '/financial-services/combination-insurance/' },
    ],
    cta: { label: 'Request a Quote', href: '/financial-services/insurance-quote/' },
  },
  {
    heading: 'Planning',
    image: '/illustrations/planning.jpg',
    imageAlt: 'A grandmother and her grandson lifting carrots from a backyard garden',
    overview: { label: 'Planning Overview', href: '/financial-services/planning/' },
    links: [
      { label: 'Charitable Giving', href: '/charitable-giving/' },
      { label: 'Estate Planning', href: '/financial-services/estate-planning/' },
      { label: 'Retirement Income Planning', href: '/retirement-income-planning/' },
    ],
    cta: null,
  },
];
---

<BaseLayout
  title="Financial Services | Heidi Blondin Financial"
  description="Investing, insurance, and planning solutions for Ontario families. Retirement savings, life insurance, critical illness, disability, estate planning, and more."
>

  <!-- Page Header -->
  <PageHero title="Financial Services" titleClass="font-serif text-display text-white max-w-2xl text-balance mx-auto" padding="py-20 lg:py-28"
    center
  />

  <!-- Intro -->
  <section class="bg-white pt-16 lg:pt-20 pb-0">
    <div class="container-content max-w-3xl">
      <div class="font-sans text-[18px] text-brand-ink/75 leading-relaxed space-y-4">
        <p>Heidi Blondin Financial works with families, retirees, and self-employed people in Kingston and across Eastern Ontario. Some arrive with one question, usually whether their life insurance is enough. Others want a plan built from scratch.</p>
        <p>What we offer falls into three groups. Investing covers the registered accounts most Canadians save through: RRSPs, TFSAs, RESPs, the newer FHSA, and group plans through an employer. Insurance covers what happens when income stops, whether that is illness, disability, or death. Planning takes the longer view, across retirement income, your estate, and charitable giving.</p>
        <p>We are independent, so we are not tied to one company's shelf. That matters more than it sounds. It lets us compare across insurers and fund companies, and it means a recommendation is not a quota being filled.</p>
        <p>If you are not sure where to start, these are the pages people open most often:</p>
      </div>

      <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3">
        {mostRequested.map(item => (
          <a href={item.href} class="group flex items-center gap-2 border border-brand-plum/10 px-4 py-3 hover:border-brand-plum/25 hover:shadow-sm transition-all">
            <span class="flex-1 font-sans text-[14px] font-semibold text-brand-plum group-hover:text-brand-goldDark transition-colors">{item.label}</span>
            <svg class="w-3 h-3 text-brand-gold flex-shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Three-Column Service Sections -->
  <section class="bg-white section-gap">
    <div class="container-content">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">
        {sections.map(section => (
          <div>
            <img
              src={section.image}
              alt={section.imageAlt}
              width="1264"
              height="848"
              loading="lazy"
              decoding="async"
              class="w-full aspect-[3/2] object-cover mb-5"
            />
            <!-- Section heading -->
            <h2 class="font-serif text-xl text-brand-plum border-b border-brand-tintPlum pb-3 mb-5">
              {section.heading}
            </h2>

            <!-- Overview link -->
            {section.overview && (
              <a
                href={section.overview.href}
                class="group flex items-center gap-2 mb-4 font-sans text-[15px] font-semibold text-brand-plum hover:text-brand-goldDark transition-colors"
              >
                {section.overview.label}
                <svg class="w-3.5 h-3.5 text-brand-gold group-hover:translate-x-0.5 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
              </a>
            )}

            <!-- Sub-links -->
            <ul class="space-y-2">
              {section.links.map(item => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center gap-2 font-sans text-[15px] text-brand-ink/75 hover:text-brand-plum transition-colors py-0.5"
                  >
                    <svg class="w-3 h-3 text-brand-gold/60 group-hover:text-brand-gold group-hover:translate-x-0.5 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>

            <!-- Section CTA -->
            {section.cta && (
              <div class="mt-5">
                <a
                  href={section.cta.href}
                  class="font-sans text-[14px] font-medium text-brand-goldDark border border-brand-gold px-4 py-2 hover:bg-brand-gold hover:text-white transition-colors inline-block tracking-wide uppercase"
                >
                  {section.cta.label} &rarr;
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-tintPlum section-gap">
    <div class="container-content text-center max-w-2xl mx-auto">
      <p class="font-sans text-[18px] text-brand-ink/80 leading-relaxed mb-8">
        If you have questions or would like more information, Contact Heidi today or ask for a quote.
      </p>
      <a href="/contact/" class="btn-primary-gold">Contact Heidi</a>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="bg-white section-gap">
    <div class="container-content max-w-3xl mx-auto">
      <blockquote class="border-l-4 border-brand-gold pl-8">
        <p class="font-sans text-[18px] text-brand-ink/80 leading-relaxed">
          My partner and I have worked with Heidi Blondin of Blondin Financial for almost a year. We recently retired and needed help with our financial planning and investments. We needed sound, honest and prudent advice. First and foremost was to find someone that we could trust, feel comfortable and confident with and who understood our personal needs and desires. This is Heidi. More than thrilled to have found someone that meets all of our requirements and more. We honestly feel so fortunate to have found her. P.M. &ndash; Kingston, Ontario
        </p>
      </blockquote>
      <div class="mt-8 pl-8">
        <a href="https://www.google.com/maps/place/Heidi+Blondin+Financial/@44.2602899,-76.5399038,17z/data=!4m8!3m7!1s0x4cd2ab2e0b9dc5f3:0xf4fc562e5c6d96cc!8m2!3d44.2602899!4d-76.5377151!9m1!1b1" target="_blank" rel="noopener" class="font-sans text-[15px] font-semibold text-brand-goldDark hover:underline">See &amp; Write Reviews for Heidi<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

</BaseLayout>
