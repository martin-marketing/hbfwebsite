---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const {
  title,
  description = 'Heidi Blondin Financial Inc. — Certified Financial Planner serving Kingston and Ontario families since 2007. Mutual funds through Investia Financial Services Inc.',
  image = '/team/team-2026.jpg',
  noindex = false,
  canonical,
} = Astro.props;

const siteUrl = 'https://heidiblondin.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Heidi Blondin Financial" />

  <!-- Twitter/X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

  <!-- Organization schema on every page -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["Organization", "FinancialService", "LocalBusiness"],
    "name": "Heidi Blondin Financial Inc.",
    "url": "https://heidiblondin.com",
    "logo": "https://heidiblondin.com/logos/heidiblondinfinancial_investia_logos_header_V1.png",
    "telephone": ["+16138872726", "+18558443927"],
    "email": "hbadmin@heidiblondin.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "785 Midpark Drive, Suite 100",
      "addressLocality": "Kingston",
      "addressRegion": "ON",
      "postalCode": "K7M 7G3",
      "addressCountry": "CA"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Ontario"
    },
    "foundingDate": "2013",
    "sameAs": []
  })} />

  {ga4Id && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', ga4Id, { anonymize_ip: true });
      </script>
    </>
  )}

  <!-- Attribution capture -->
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('hbf_attribution')) return;

        var params = new URLSearchParams(location.search);
        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'];
        var found = {};
        var hasParam = false;
        keys.forEach(function (key) {
          var value = params.get(key);
          if (value) {
            found[key] = value;
            hasParam = true;
          }
        });

        var referrer = document.referrer || '';
        var isExternalReferrer = referrer && referrer.indexOf(location.hostname) === -1;

        if (hasParam || isExternalReferrer) {
          found.referrer = referrer;
          found.landing_page = location.pathname;
          sessionStorage.setItem('hbf_attribution', JSON.stringify(found));
        }
      } catch (e) {
        /* sessionStorage unavailable, no-op */
      }
    })();
  </script>

  <!-- tel:/mailto: click tracking -->
  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        if (typeof window.gtag !== 'function') return;
        var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (href.indexOf('tel:') === 0) {
          window.gtag('event', 'phone_call');
        } else if (href.indexOf('mailto:') === 0) {
          window.gtag('event', 'email_click');
        }
      });
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
