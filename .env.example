# Supabase — copy to .env and fill in real values
# Project URL and anon key are safe to expose in build (public-facing)
SUPABASE_URL=https://yaxoojfticqjnyxeyfgn.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — server-side only, NEVER expose in client bundle or commit
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Resend — for form email notifications (Cloudflare Pages Function)
RESEND_API_KEY=your_resend_key_here

# Cloudflare Turnstile — form spam protection
TURNSTILE_SECRET_KEY=your_turnstile_secret_here
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable GA4 entirely.
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console — HTML tag verification content value (from the meta verification tag). Leave unset to skip.
PUBLIC_GSC_VERIFICATION=
